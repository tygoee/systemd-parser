{
  "include": ["lib/index.ts", "lib/**/*"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "rootDir": "lib",
    "outDir": "dist",
    "declaration": true,

    "strict": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true
  }
}
